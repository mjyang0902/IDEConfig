// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "proxy": "",
  "hide_mouse": "on_typing_and_movement",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 300
  },
  "outline_panel": {
    "button": true,
    "dock": "left",
    "default_width": 300
  },
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 520
  },
  "theme": "One Dark",
}
